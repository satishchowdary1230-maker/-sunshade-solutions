# ==============================================================================
# Sunshade Solutions Backend API - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/sunshade_solutions?retryWrites=true&w=majority
# If left blank, the backend runs in resilient in-memory mode with sample Hyderabad leads!
MONGODB_URI=

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# Admin Secret
ADMIN_SECRET_KEY="sunshade_admin_secret_2026"
